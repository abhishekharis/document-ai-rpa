# development | staging | production (staging/production enforce a real RPA_API_KEY and non-localhost CORS)
ENVIRONMENT=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=document_ai_rpa
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=10
CONFIDENCE_THRESHOLD=0.80
API_HOST=127.0.0.1
API_PORT=8000
ACCOUNTING_APP_URL=http://localhost:3001
# Must be a secret of 16+ characters outside development
RPA_API_KEY=change-me-in-production
# JSON list, e.g. ["https://app.example.com"]
# CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_RATE_LIMIT_PER_MINUTE=30
RPA_RATE_LIMIT_PER_MINUTE=120
API_BASE_URL=http://127.0.0.1:8000
RPA_POLL_INTERVAL=30
